{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGotten",
  "version": "0.1.0",
  "identifier": "com.sivartydrup.gitgotten",
  "build": {
    "beforeDevCommand": "cd src && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd src && pnpm build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitGotten",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDNkQ3QUFGNEMzMDQ5QkIKUldTN1NUQk1yM3B0SEpXWEh3WmVJRUw4bEdERDZTd2lpZ3VYNVQxbkNRNjlKRE05VTZGREJPSEwK",
      "endpoints": [
        "https://github.com/sivartydrup/git-gotten/releases/latest/download/latest.json"
      ]
    }
  }
}
